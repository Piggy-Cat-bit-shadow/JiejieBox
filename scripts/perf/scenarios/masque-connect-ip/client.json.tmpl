{
  "log": {"level": "info", "timestamp": true},
  "endpoints": [
    {
      "type": "masque-client",
      "tag": "masque",
      "server": "__SERVER_ADDR__",
      "server_port": __SERVER_PORT__,
      "system": false,
      "mtu": 1400,
      "username": "bench",
      "password": "__PASSWORD__",
      "version": 3,
      "tls": {
        "enabled": true,
        "server_name": "__SERVER_NAME__",
        "certificate_path": "__CA__",
        "alpn": ["h3"]
      }
    }
  ],
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "__CLIENT_ADDR__",
      "listen_port": __CLIENT_PORT__
    }
  ],
  "outbounds": [
    {"type": "direct", "tag": "direct"}
  ],
  "route": {
    "rules": [
      {"inbound": ["socks-in"], "action": "route", "outbound": "masque"}
    ]
  }
}
