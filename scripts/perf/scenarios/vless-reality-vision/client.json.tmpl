{
  "log": {"level": "info", "timestamp": true},
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "__CLIENT_ADDR__",
      "listen_port": __CLIENT_PORT__
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "__SERVER_ADDR__",
      "server_port": __SERVER_PORT__,
      "uuid": "__UUID__",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "__SERVER_NAME__",
        "utls": {"enabled": true, "fingerprint": "chrome"},
        "reality": {
          "enabled": true,
          "public_key": "__REALITY_PUBLIC__",
          "short_id": "__SHORT_ID__"
        }
      }
    }
  ],
  "route": {"final": "proxy"}
}
