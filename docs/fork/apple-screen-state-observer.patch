+    /// Bumps the generation and returns the new value. Safe from any thread.
+    private func advanceGeneration() -> UInt64 {
+        access.lock()
+        defer { access.unlock() }
+        generation &+= 1
+        return generation
+    }
+
+    /// Bumps the generation AND publishes the token table under the same acquisition.
+    ///
