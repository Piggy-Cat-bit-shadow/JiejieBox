+        case (.displayOff, .edge):
+            publisher.recordScreenState(on: false)
+        case (.locked, .edge):
+            publisher.recordLockState(locked: true)
+        case (.unlocked, .edge):
+            publisher.recordLockState(locked: false)
+        case (.displayOff, .level):
